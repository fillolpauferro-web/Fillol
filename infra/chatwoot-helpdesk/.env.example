# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA commite o arquivo ".env" (já está no .gitignore) — ele contém segredos.

# --- Aplicação ---
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_NAME=Suporte Empresa
INSTALLATION_ENV=docker
# Enquanto não houver domínio, use o IP público do servidor, ex: http://203.0.113.10
# Depois de migrar para domínio, trocar para https://suporte.empresa.com
FRONTEND_URL=http://SEU_IP_AQUI
DEFAULT_LOCALE=pt_BR

# Gerar com: openssl rand -hex 64
SECRET_KEY_BASE=

# --- Banco de dados ---
POSTGRES_HOST=postgres
POSTGRES_USER=chatwoot
POSTGRES_PASSWORD=
POSTGRES_DATABASE=chatwoot

# --- Redis ---
REDIS_URL=redis://:__REDIS_PASSWORD__@redis:6379
REDIS_PASSWORD=

# --- E-mail (Google Workspace) ---
# Conta de app dedicada, ex: suporte@empresa.com, com senha de app do Google
# (não a senha normal da conta — gerar em myaccount.google.com/apppasswords).
MAILER_SENDER_EMAIL=Suporte Empresa <suporte@empresa.com>
SMTP_DOMAIN=empresa.com
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=suporte@empresa.com
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Recebimento de e-mail (inbox "Vendas"/"Atendimento Externo"/"Suporte Interno"
# são configurados depois, pelo painel admin — ver RUNBOOK.md).
IMAP_ADDRESS=imap.gmail.com
IMAP_PORT=993

# --- Storage de backup (preenchido pelo scripts/backup.sh, não pela app) ---
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# --- Alerta de healthcheck ---
HEALTHCHECK_ALERT_EMAIL=ti@empresa.com
